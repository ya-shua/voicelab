# ================= 语音引擎（TTS / 识别 / 音色克隆）=================
# 二选一：zhipu（智谱）| siliconflow（硅基流动）
VOICE_PROVIDER=zhipu

# 智谱：https://open.bigmodel.cn → 「API Keys」页新建
ZHIPU_API_KEY=
# 硅基流动：https://cloud.siliconflow.cn/account/ak （克隆音色需先实名认证）
SILICONFLOW_API_KEY=

# ================= 对话大模型（想接哪家填哪家）=====================
# 全部 OpenAI 兼容接口；配了哪家的 KEY，页面「对话模型」下拉里就多了哪家。
# 默认用哪家（填预设 id：zhipu / siliconflow / deepseek / moonshot /
# dashscope / openai / openrouter / custom）；留空自动挑第一个配了 key 的。
LLM_PROVIDER=

# 智谱 GLM（glm-4-flash 免费）
ZHIPU_API_KEY=          # ↑和语音引擎共用同一个 key
# 硅基流动（Qwen2.5-7B 免费档）
SILICONFLOW_API_KEY=
# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=
# 月之暗面 Kimi：https://platform.moonshot.cn
MOONSHOT_API_KEY=
# 阿里百炼 Qwen：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=
# OpenAI：https://platform.openai.com
OPENAI_API_KEY=
# OpenRouter（一个 key 调几十家模型）：https://openrouter.ai
OPENROUTER_API_KEY=

# 自定义接入（Ollama / vLLM / LM Studio / 任意中转站）：
#   Ollama 示例：CUSTOM_LLM_BASE_URL=http://127.0.0.1:11434/v1
#                CUSTOM_LLM_MODEL=qwen2.5:7b   （key 随便填一个非空值）
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# 想换某家的默认模型？用 <ID大写>_LLM_MODEL 覆盖，例如：
# DEEPSEEK_LLM_MODEL=deepseek-reasoner
# MOONSHOT_LLM_MODEL=kimi-k2-0905-preview

# ================= 对外接口（给酒馆 / QQ机器人 / Discord 等平台用）=================
# 设置后，/v1/* 接口必须带 Authorization: Bearer <这里填的值>
# 留空 = 不鉴权（只建议纯本机自用时留空）
VOICELAB_TOKEN=

# ================= 语音（留空用默认）===============================
# 默认音色 id（智谱默认 female；硅基默认 FunAudioLLM/CosyVoice2-0.5B:alex）
TTS_VOICE=
# 语速 0.25 ~ 4.0
TTS_SPEED=1.0
